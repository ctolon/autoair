# syntax=docker/dockerfile:1
# Demo image built from the working tree: no prebuilt wheel, host Node or Python needed.
# Used by deploy/compose/docker-compose.demo.yml for Airflow, the AutoAir plugin, the
# standalone replicas, the AI service and the one-shot jobs.
ARG AIRFLOW_VERSION=3.3.2

FROM node:22-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS package
WORKDIR /build
RUN pip install --no-cache-dir build
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
COPY --from=frontend /build/src/autoair/static/ src/autoair/static/
RUN python -m build --wheel

FROM apache/airflow:${AIRFLOW_VERSION}
ARG AIRFLOW_VERSION
LABEL org.opencontainers.image.title="autoair-demo" \
      org.opencontainers.image.description="AutoAir demo image (Airflow ${AIRFLOW_VERSION} + AutoAir from the working tree)" \
      org.opencontainers.image.source="https://github.com/ctolon/autoair" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --chown=airflow:0 --from=package /build/dist/*.whl /tmp/autoair/
# Pinning apache-airflow keeps pip from up- or downgrading the base image's Airflow.
RUN pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" \
    "$(find /tmp/autoair -name '*.whl')[standalone,format,git,ai,ai-openai,ai-anthropic,collab,collab-redis,postgres,otel,yaml]" \
    apache-airflow-providers-standard apache-airflow-providers-git \
    && rm -rf /tmp/autoair
