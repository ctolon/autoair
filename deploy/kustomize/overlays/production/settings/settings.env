# Settings of this deployment (one KEY=value per line, no quotes around JSON). Everything
# marked "example" must be changed. Reference: docs/configuration-reference.md.

# --- Airflow as the pods reach it (example), and as browsers reach it (example)
AUTOAIR_AIRFLOW_URL=http://airflow-api-server.airflow.svc.cluster.local:8080
AUTOAIR_SSO__AIRFLOW_PUBLIC_URL=https://airflow.example.com
# Take a replica out of rotation when Airflow's API does not answer either.
AUTOAIR_SERVER__READY_CHECK_AIRFLOW=true

# --- the UI's public address (example; also the host in ../../../components/ingress)
AUTOAIR_SERVER__PUBLIC_URL=https://autoair.example.com
# The ingress controller's pod network (example): trusted for X-Forwarded-Proto/For.
AUTOAIR_SERVER__FORWARDED_ALLOW_IPS=["10.0.0.0/8"]

# --- state: PostgreSQL (example host; password from the Secret autoair-db)
AUTOAIR_DATABASE__URL=postgresql+psycopg://autoair@autoair-db.example.internal:5432/autoair
AUTOAIR_DATABASE__SSL_MODE=require

# --- deploy target: git (example repository; token from the Secret autoair-git)
AUTOAIR_STORAGE__GIT__PROVIDER=github
AUTOAIR_STORAGE__GIT__REPO=acme/airflow-dags
AUTOAIR_STORAGE__GIT__BASE_BRANCH=main
AUTOAIR_STORAGE__GIT__SUBDIR=dags/autoair
AUTOAIR_STORAGE__GIT__COMMITTER_EMAIL=autoair@example.com

# --- import checks: the validator service (../../../components/validator). closed: while
# it cannot be asked, deploys are refused (import_service error) instead of going ahead
# without an import check (the application default, open).
AUTOAIR_VALIDATOR__FAIL_MODE=closed

# --- organisation policy
AUTOAIR_ENVIRONMENTS=["dev","prod"]
AUTOAIR_DEFAULT_ENVIRONMENT=prod
AUTOAIR_REQUIRE_OWNER=true
AUTOAIR_MIN_RETRIES=1
