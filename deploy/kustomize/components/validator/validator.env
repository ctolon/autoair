# AUTOAIR_VALIDATOR__* settings (docs/configuration-reference.md, section validator);
# the values of deploy/helm/autoair-validator/values.yaml.
AUTOAIR_VALIDATOR__SECRET_CONN_ID=autoair_validator
AUTOAIR_VALIDATOR__POOL_SIZE=2
AUTOAIR_VALIDATOR__MAX_TASKS_PER_CHILD=1
AUTOAIR_VALIDATOR__MEMORY_LIMIT_MB=1024
AUTOAIR_VALIDATOR__CPU_LIMIT_SECONDS=120
AUTOAIR_VALIDATOR__FILE_SIZE_LIMIT_MB=16
AUTOAIR_VALIDATOR__MAX_REQUEST_BYTES=4194304
AUTOAIR_VALIDATOR__MAX_CHECK_SECONDS=120
AUTOAIR_VALIDATOR__AUDIT_HOOK=true
# Unprivileged user namespaces are usually blocked by the RuntimeDefault seccomp profile;
# "auto" then relies on the NetworkPolicy of this component.
AUTOAIR_VALIDATOR__NETWORK_ISOLATION=auto
AUTOAIR_LOGGING__FORMAT=json
AIRFLOW_HOME=/tmp/airflow
HOME=/tmp
AUTOAIR_CACHE_DIR=/tmp/autoair-cache
