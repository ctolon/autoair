# The AutoAir server calls the validator for every import check.
AUTOAIR_VALIDATOR__URL=http://autoair-validator:8791
# open (the default): while the validator is unreachable, deploys go ahead with an
# import_service warning and no import check; DAG code never runs in the server. Set closed
# to refuse deploys instead, or local to fall back to the server's own DagBag pool.
AUTOAIR_VALIDATOR__FAIL_MODE=open
AUTOAIR_VALIDATOR__SECRET_CONN_ID=autoair_validator
