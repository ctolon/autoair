AUTOAIR_STORAGE__MODE=git
AUTOAIR_STORAGE__GIT__PROVIDER=github
AUTOAIR_STORAGE__GIT__REPO=acme/airflow-dags
AUTOAIR_STORAGE__GIT__BASE_BRANCH=main
AUTOAIR_STORAGE__GIT__SUBDIR=dags/autoair
AUTOAIR_STORAGE__GIT__MODE=pr
# The Airflow connection holding the token (AIRFLOW_CONN_GIT_DAGS below). A standalone pod
# has no Airflow configuration to read a GitDagBundle from, so repo and branch are explicit.
AUTOAIR_STORAGE__GIT__CONN_ID=git_dags
AUTOAIR_STORAGE__GIT__COMMITTER_NAME=AutoAir
AUTOAIR_STORAGE__GIT__COMMITTER_EMAIL=autoair@example.com
