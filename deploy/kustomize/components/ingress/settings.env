# The UI as users reach it: links in commits and pull requests, the sign-in return URL.
AUTOAIR_SERVER__PUBLIC_URL=https://autoair.example.com
# Airflow as browsers reach it ("Sign in with Airflow").
AUTOAIR_SSO__AIRFLOW_PUBLIC_URL=https://airflow.example.com
# Peers whose X-Forwarded-Proto/For are trusted: the ingress controller's (or Gateway's) pod network.
# Narrow it to that range; components/network-policies lets only the controller in.
AUTOAIR_SERVER__FORWARDED_ALLOW_IPS=["10.0.0.0/8"]
# Every client uses HTTPS through the ingress.
AUTOAIR_SERVER__HSTS_SECONDS=31536000
