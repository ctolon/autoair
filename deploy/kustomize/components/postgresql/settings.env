AUTOAIR_DATABASE__BACKEND=postgresql
# The password is not part of the URL: AUTOAIR_DATABASE__PASSWORD from the Secret autoair-db.
AUTOAIR_DATABASE__URL=postgresql+psycopg://autoair@autoair-db.example.internal:5432/autoair
# verify-full with AUTOAIR_DATABASE__SSL_ROOT_CERT (a mounted CA bundle) where the server's
# certificate allows it.
AUTOAIR_DATABASE__SSL_MODE=require
AUTOAIR_DATABASE__CONNECT_ARGS={"connect_timeout": 10, "application_name": "autoair"}
# The init container migrates; replicas refuse to start on an older schema instead of racing.
AUTOAIR_DATABASE__MIGRATE_ON_START=false
