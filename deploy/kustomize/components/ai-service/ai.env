# Settings only the AI service reads (it also loads autoair-config).
AUTOAIR_AI__ENABLED=true
# The model and its key: the Airflow connection autoair_llm (AIRFLOW_CONN_AUTOAIR_LLM from
# the Secret autoair-ai), in the common.ai "pydanticai" format.
AUTOAIR_AI__LLM_CONN_ID=autoair_llm
AUTOAIR_AI__SERVICE__VERIFY_TOKENS=true
# The AI service runs the model itself; this setting only matters on the proxying server.
AUTOAIR_AI__SERVICE_URL=
AUTOAIR_AI__SERVICE__PROXY_MCP=false
