# Non-secret settings of `autoair serve` (one KEY=value per line, values taken literally:
# no quotes around JSON). Secrets never go here: they come from Kubernetes Secrets as
# environment variables, Airflow connections included (see ../README.md).
AUTOAIR_SERVER__HOST=0.0.0.0
AUTOAIR_SERVER__PORT=8765
AUTOAIR_SERVER__GRACEFUL_SHUTDOWN_TIMEOUT=25
# Airflow as AutoAir reaches it: token checks, pickers, runs, logs. The Service name of the
# official chart's api-server in the namespace "airflow"; change it to yours.
AUTOAIR_AIRFLOW_URL=http://airflow-api-server.airflow.svc.cluster.local:8080
# Deploy target: local files on the "dags" volume (an emptyDir here, a PersistentVolumeClaim
# in overlays/dev). Production uses ../components/git-target.
AUTOAIR_STORAGE__MODE=local
AUTOAIR_DAGS_FOLDER=/opt/airflow/dags
AUTOAIR_LOGGING__FORMAT=json
AUTOAIR_EXPOSE_CONFIG=non-sensitive-only
