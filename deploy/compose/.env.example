# AutoAir demo stack: every knob of docker-compose.demo.yml.
#   cp .env.example .env      (Compose reads .env next to the compose file automatically)
# Every line is optional: the value shown is the built-in default. Uncomment to change it.
# Profile presets (env/*.env) are layered on top with a second --env-file; see README.md.
#
# All secrets below are public demo values. Change them before the stack is reachable by
# anyone else, and never reuse them anywhere.

# ------------------------------------------------------------------ compose
# COMPOSE_PROJECT_NAME=autoair-demo     # container/volume prefix (or: docker compose -p NAME)
# COMPOSE_PROFILES=                     # e.g. lb,redis  (same as --profile lb --profile redis)

# ------------------------------------------------------------------ image
# DEMO_IMAGE=autoair-demo:local         # tag of the image built from the working tree
# DEMO_AIRFLOW_VERSION=3.3.2            # apache/airflow base image (any 3.x >= 3.0)

# ------------------------------------------------------------------ host ports (loopback only)
# DEMO_AIRFLOW_PORT=8080                # Airflow UI/API + the AutoAir plugin
# DEMO_AUTOAIR_A_PORT=8765              # standalone replica A  (/ui/)
# DEMO_AUTOAIR_B_PORT=8766              # standalone replica B  (/ui/)
# DEMO_POSTGRES_PORT=5433               # PostgreSQL (psql -h 127.0.0.1 -p 5433 -U postgres)
# DEMO_LB_PORT=8780                     # profile lb: nginx in front of A and B
# DEMO_AI_PORT=8790                     # profile ai: autoair ai-serve
# DEMO_OLLAMA_PORT=11434                # profile ollama
# DEMO_GITEA_PORT=3000                  # profile git: Gitea web UI and HTTP git
# DEMO_TLS_PORT=8443                    # profile tls: HTTPS proxy in front of A and B
# DEMO_TLS_AIRFLOW_PORT=9443            # profile tls: HTTPS proxy in front of Airflow
# DEMO_TLS_AUTOAIR_PORT=8445            # profile tls: replica serving HTTPS itself
# DEMO_JAEGER_PORT=16686                # profile observability: Jaeger UI

# ------------------------------------------------------------------ PostgreSQL
# Passwords are applied on the FIRST start of the postgres volume only (initdb). Changing
# them later needs `down -v` (erases the demo) or ALTER ROLE. Use URL-safe characters.
# DEMO_POSTGRES_PASSWORD=postgres-demo-only    # superuser "postgres"
# DEMO_AIRFLOW_DB_PASSWORD=airflow-demo-only   # role/database "airflow" (Airflow metadata)
# DEMO_AUTOAIR_DB_PASSWORD=autoair-demo-only   # role/database "autoair" (AutoAir state)

# ------------------------------------------------------------------ Airflow
# Fernet key encrypting connection passwords (git token!). Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEMO_FERNET_KEY=6c3JJdtyiF5gkdKTnUFKpNub4Kcc-3vthcY4xSUi7xE=
# Airflow token signing key (>= 64 bytes avoids PyJWT's short-key warning)
# DEMO_JWT_SECRET=local-demo-jwt-secret-change-before-exposing-0123456789abcdef0123456789abcdef
# DEMO_JWT_EXPIRATION_TIME=86400        # seconds an Airflow access token lives
# DEMO_API_SECRET_KEY=local-demo-api-secret-key
# DEMO_AIRFLOW_API_WORKERS=2
# DEMO_AIRFLOW_LOG_LEVEL=INFO
# Bundles the dag-processor reads (JSON). env/git.env adds the Gitea GitDagBundle.
# DEMO_DAG_BUNDLE_CONFIG_LIST=[{"name": "dags-folder", "classpath": "airflow.dag_processing.bundles.local.LocalDagBundle", "kwargs": {}}]

# ------------------------------------------------------------------ AutoAir (all containers)
# DEMO_EXPOSE_CONFIG=non-sensitive-only # GET /api/config for admins: false|true|non-sensitive-only
# DEMO_AUTOAIR_LOG_LEVEL=INFO           # DEBUG|INFO|WARNING|ERROR
# DEMO_AUTOAIR_LOG_FORMAT=text          # text|json
# DEMO_COLLAB_SECRET=local-demo-collab-secret   # HMAC of collaboration tickets (all replicas)
# DEMO_SEED_DAGS=true                   # deploy seed/specs/*.json once the stack is up
#
# Anything else: put AUTOAIR_* variables in ./autoair.env (read by every AutoAir container,
# lower precedence than the compose file) or edit config/autoair.yaml (feature flags, IAM role
# mapping, policy and governance rules). Reference: docs/configuration-reference.md.

# ------------------------------------------------------------------ collaboration fan-out
# DEMO_COLLAB_SYNC=database             # database (PostgreSQL LISTEN/NOTIFY) | redis | memory
# DEMO_COLLAB_REDIS_URL=                # set by env/redis.env
# DEMO_REDIS_PASSWORD=redis-demo-only   # profile redis

# ------------------------------------------------------------------ deploy target
# DEMO_STORAGE_MODE=local               # local (shared dags volume) | git (env/git.env)
# DEMO_GIT_MODE=pr                      # git: pr (branch per DAG) | push (commit to main)
# DEMO_GIT_CONN_ID=gitea_dags           # Airflow connection holding the Gitea token
# DEMO_GITEA_USER=autoair               # profile git: Gitea admin user (web login too)
# DEMO_GITEA_PASSWORD=autoair-demo-only
# DEMO_GITEA_REPO=dags
# DEMO_GITEA_VERSION=1.24-rootless

# ------------------------------------------------------------------ AI (off: no charges)
# DEMO_AI_ENABLED=false                 # true via env/ai.env or env/ollama.env
# DEMO_AI_PROVIDER=openai               # anthropic | openai | gemini | ollama
# DEMO_AI_MODEL=                        # empty: the provider's default model
# DEMO_AI_API_KEY=                      # hosted providers bill per token
# DEMO_AI_BASE_URL=                     # OpenAI-compatible / Ollama / gateway URL
# DEMO_AI_SERVICE_URL=                  # http://autoair-ai:8790 with profile ai
# DEMO_AI_SERVICE_SECRET=local-demo-ai-hmac-secret   # HMAC shared by replicas and AI service
# DEMO_OLLAMA_MODEL=qwen2.5:1.5b        # profile ollama: pulled by ollama-pull
# DEMO_OLLAMA_VERSION=latest

# ------------------------------------------------------------------ observability
# DEMO_OTEL_ENABLED=false               # true via env/observability.env
# DEMO_OTEL_COLLECTOR_VERSION=0.116.1
# DEMO_JAEGER_VERSION=1.65.0
