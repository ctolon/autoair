# Preset for the `redis` profile: collaboration rooms fan out through Redis pub/sub instead of
# PostgreSQL LISTEN/NOTIFY.  ... --env-file .env --env-file env/redis.env --profile redis up -d
DEMO_COLLAB_SYNC=redis
DEMO_COLLAB_REDIS_URL="redis://:${DEMO_REDIS_PASSWORD:-redis-demo-only}@redis:6379/0"
