# Preset for `--profile ai --profile ollama`: a local model, no provider charges.
#   ... --env-file .env --env-file env/ollama.env --profile ai --profile ollama up -d
# The first start pulls the model (about 1 GB for qwen2.5:1.5b); CPU answers are slow.
DEMO_AI_ENABLED=true
DEMO_AI_SERVICE_URL=http://autoair-ai:8790
DEMO_AI_PROVIDER=ollama
DEMO_AI_BASE_URL=http://ollama:11434
DEMO_AI_MODEL="${DEMO_OLLAMA_MODEL:-qwen2.5:1.5b}"
DEMO_AI_API_KEY=
