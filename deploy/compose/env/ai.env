# Preset for the `ai` profile with a hosted provider: the replicas and the plugin proxy
# /api/ai/* to the separate AI service (autoair ai-serve), signing the caller's identity with
# the shared HMAC secret DEMO_AI_SERVICE_SECRET.
#   ... --env-file .env --env-file env/ai.env --profile ai up -d
# Hosted providers bill per token. Put the key in .env (DEMO_AI_API_KEY), not here.
DEMO_AI_ENABLED=true
DEMO_AI_SERVICE_URL=http://autoair-ai:8790
# DEMO_AI_PROVIDER=anthropic   # anthropic | openai | gemini | ollama
# DEMO_AI_MODEL=               # empty: the provider's default model
