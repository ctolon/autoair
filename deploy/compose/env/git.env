# Preset for the `git` profile: Gitea becomes the deploy target and Airflow reads it back
# through a GitDagBundle named "gitea" that uses the connection git-bootstrap registers.
#   docker compose -f docker-compose.demo.yml --env-file .env --env-file env/git.env \
#       --profile git up -d
# If you change DEMO_GIT_CONN_ID in .env, change "git_conn_id" below to match.
DEMO_STORAGE_MODE=git
# pr: one branch per DAG (autoair/<dag_id>), merged in Gitea; push: commit straight to main.
DEMO_GIT_MODE=pr
DEMO_DAG_BUNDLE_CONFIG_LIST='[{"name": "dags-folder", "classpath": "airflow.dag_processing.bundles.local.LocalDagBundle", "kwargs": {}}, {"name": "gitea", "classpath": "airflow.providers.git.bundles.git.GitDagBundle", "kwargs": {"git_conn_id": "gitea_dags", "tracking_ref": "main", "refresh_interval": 30}}]'
