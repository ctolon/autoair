{
  "name": "autoair-frontend",
  "private": true,
  "version": "0.2.3",
  "description": "AutoAir editor UI (Airflow plugin and standalone bundles)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --mode standalone",
    "build": "npm run build:plugin && npm run build:standalone",
    "build:plugin": "vite build --mode plugin",
    "build:standalone": "vite build --mode standalone",
    "codegen": "cd .. && uv run autoair export-openapi --output frontend/openapi.json && cd frontend && openapi-ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "test:visual": "node e2e/visual/run.mjs",
    "test:visual:plugin": "node e2e/visual/run.mjs --plugin"
  },
  "dependencies": {
    "@chakra-ui/react": "~3.37.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@emotion/react": "^11.14.0",
    "@lezer/highlight": "^1.2.5",
    "@rjsf/chakra-ui": "6.11.0",
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "chakra-react-select": "^6.1.3",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "i18next": "^26.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.4"
  }
}
